# Connection strings for Django / Celery settings
DATABASE_URL=postgres://gridops:change-me@localhost:5432/gridops
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
